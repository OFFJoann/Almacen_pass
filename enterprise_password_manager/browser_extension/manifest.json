{
  "manifest_version": 3,
  "name": "TICOlvidé - Gestor de Contraseñas",
  "version": "1.0.0",
  "description": "Extensión oficial de TICOlvidé. Autocompleta, guarda y genera contraseñas desde tu navegador.",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TICOlvidé",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
